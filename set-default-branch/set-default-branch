set -u

PROVIDER="gh"

usage() {
    echo "Usage: $(basename "$0") [--provider gh|glab] ORG BRANCH [BRANCH...]" >&2
}

while [[ "${1:-}" == -* ]]; do
    case "$1" in
        --provider=*)
            PROVIDER="${1#*=}"
            shift
            ;;
        --provider | -p)
            PROVIDER="${2:?Missing value for $1}"
            shift 2
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage
            exit 1
            ;;
    esac
done

if [[ "$#" -lt 2 ]]; then
    usage
    exit 1
fi

if [[ "${PROVIDER}" != "gh" && "${PROVIDER}" != "glab" ]]; then
    echo "Invalid provider: ${PROVIDER} (expected gh or glab)" >&2
    usage
    exit 1
fi

ORG="$1"
BRANCHES=("${@:2}")

list_glab_repos() {
    local page=1
    while true; do
        local json
        json=$(glab repo list --group "${ORG}" --include-subgroups --per-page 100 --page "${page}" --output json)
        local count
        count=$(echo "${json}" | jq 'length')
        if [[ "${count}" -eq 0 ]]; then
            break
        fi
        # Skip archived projects (read-only, default branch can't be changed)
        echo "${json}" | jq --raw-output '.[] | select(.archived != true) | .path_with_namespace'
        if [[ "${count}" -lt 100 ]]; then
            break
        fi
        page=$((page + 1))
    done
}

glab_branch_exists() {
    local project="$1"
    local branch="$2"
    local encoded="${project//\//%2F}"
    glab api "projects/${encoded}/repository/branches/${branch}" >/dev/null 2>&1
}

if [[ "${PROVIDER}" == "glab" ]]; then
    for repo in $(list_glab_repos); do
        updated=false
        for branch in "${BRANCHES[@]}"; do
            if glab_branch_exists "${repo}" "${branch}"; then
                glab repo update "${repo}" --defaultBranch "${branch}"
                updated=true
                break
            fi
        done
        if [[ "${updated}" != "true" ]]; then
            echo "Skipping ${repo}: none of [${BRANCHES[*]}] exists" >&2
        fi
    done
else
    for repo in $(gh repo list "${ORG}" -L 99999 --json name,isArchived --jq '.[] | select(.isArchived != true) | .name'); do
        updated=false
        for branch in "${BRANCHES[@]}"; do
            if gh api "repos/${ORG}/${repo}/branches/${branch}" --silent >/dev/null 2>&1; then
                gh repo edit "${ORG}/${repo}" --default-branch "${branch}"
                updated=true
                break
            fi
        done
        if [[ "${updated}" != "true" ]]; then
            echo "Skipping ${ORG}/${repo}: none of [${BRANCHES[*]}] exists" >&2
        fi
    done
fi
